services:
  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: open-webui
    restart: unless-stopped
    ports:
      - "{{ open_webui_port | default(3000) }}:8080"
    environment:
      - OLLAMA_BASE_URL=http://{{ ollama_ip_address }}:{{ ollama_port | default(11434) }}
      - SCARF_NO_ANALYTICS=true
      - DO_NOT_TRACK=true
    volumes:
      - /opt/data/open-webui-data:/app/backend/data
